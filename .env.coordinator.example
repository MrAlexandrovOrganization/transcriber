TRANSCRIBER_ROLE=server
COMPOSE_PROJECT_NAME=transcriber-coordinator
WORKER_TLS_ENABLED=0
QUEUE_BACKEND=rabbitmq
COORDINATOR_TAILNET=1
COORDINATOR_TAILNET_HOSTNAME=transcriber-coordinator
ROUTER_TAILNET_ADDRESS=192.0.2.20
HEADSCALE_LOGIN_SERVER=https://headscale.example.com
HEADSCALE_AUTHKEY_PATH=/synthetic/coordinator/headscale.key
WORKER_CREDENTIALS_PATH=/synthetic/coordinator/worker-credentials.json
RABBITMQ_CONFIG_DIR=/synthetic/coordinator/rabbitmq/server
RABBITMQ_PUBLISHER_DIR=/synthetic/coordinator/rabbitmq/publisher
WORKER_POLICIES={"wsl-cpu":{"priority":10,"max_concurrency":3},"mac-m3-pro":{"priority":20,"max_concurrency":2},"wsl-gpu":{"priority":30,"max_concurrency":1}}
WORKER_AVAILABILITY_TTL_S=30
REQUIRE_AVAILABLE_WORKERS=1
MAX_AUDIO_BYTES=268435456
MAX_JOB_STORAGE_BYTES=8589934592
MIN_JOB_STORAGE_FREE_BYTES=1073741824
MAX_CONCURRENT_UPLOADS=4
