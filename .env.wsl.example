TRANSCRIBER_ROLE=workers
COMPOSE_PROJECT_NAME=transcriber-workers
COMPOSE_PROFILES=cpu,gpu
CPU_WORKER_ID=wsl-cpu
CPU_MODEL=large-v3
CPU_COMPUTE_TYPE=int8
CPU_THREADS=2
CPU_CONCURRENCY=2
CPU_LIMIT=4
CPU_MEMORY_LIMIT=5500m
GPU_WORKER_ID=wsl-gpu
GPU_MODEL=large-v3-turbo
GPU_COMPUTE_TYPE=int8_float16
GPU_THREADS=2
GPU_CONCURRENCY=1
GPU_CPU_LIMIT=1.5
GPU_MEMORY_LIMIT=3g
WORKER_UID=1000
WORKER_GID=1000
MODEL_CACHE_PATH=/home/your-login/.cache/huggingface
CPU_WORKER_TOKEN_PATH=/home/your-login/.config/transcriber/cpu.token
GPU_WORKER_TOKEN_PATH=/home/your-login/.config/transcriber/gpu.token
REMOTE_WORKER_ENDPOINT=workers.example.com:443

# Enable after the first approved public GHCR release. make up resolves it.
WORKER_AUTODEPLOY=0

# RabbitMQ cutover: provision credentials first; see docs/rabbitmq.md.
# QUEUE_BACKEND=rabbitmq
# Docker Desktop private routing (see docs/rabbitmq.md):
# WORKER_TAILNET=1
# WORKER_TAILNET_HOSTNAME=transcriber-workers-wsl
# HEADSCALE_LOGIN_SERVER=https://headscale.example.com
# HEADSCALE_AUTHKEY_PATH=/absolute/private/path/to/headscale.key
# CPU_RABBITMQ_DIR=/absolute/private/path/to/this-worker-rabbitmq
# GPU_RABBITMQ_DIR=/absolute/private/path/to/gpu-worker-rabbitmq

# Match MAX_AUDIO_BYTES on coordinator and every eligible worker. Bytes, not MiB.
MAX_AUDIO_BYTES=268435456
