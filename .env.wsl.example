TRANSCRIBER_ROLE=workers
COMPOSE_PROJECT_NAME=transcriber-workers
COMPOSE_PROFILES=cpu,gpu
CPU_WORKER_ID=wsl-cpu
CPU_MODEL=large-v3
CPU_COMPUTE_TYPE=int8
CPU_THREADS=4
CPU_LIMIT=4
CPU_MEMORY_LIMIT=5500m
GPU_WORKER_ID=wsl-gpu
GPU_MODEL=small
GPU_COMPUTE_TYPE=int8_float16
GPU_THREADS=2
GPU_CPU_LIMIT=1.5
GPU_MEMORY_LIMIT=3g
WORKER_UID=1000
WORKER_GID=1000
MODEL_CACHE_PATH=/home/your-login/.cache/huggingface
WORKER_TOKEN_PATH=/home/your-login/.config/transcriber/worker.token
SSH_HOST=your-coordinator-host
SSH_USER=your-ssh-login
SSH_PORT=22
SSH_IDENTITY_PATH=/home/your-login/.ssh/id_ed25519_transcriber
SSH_KNOWN_HOSTS_PATH=/home/your-login/.ssh/known_hosts_transcriber
