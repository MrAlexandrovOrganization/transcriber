TRANSCRIBER_ROLE=server
# Opt in to the optional local worker with COMPOSE_PROFILES=fallback.
WORKER_TLS_ENABLED=1
WORKER_CREDENTIALS_PATH=/home/your-login/.config/transcriber/worker-credentials.json
PREFERRED_WORKER_IDS=mac-m3-pro,wsl-gpu,wsl-cpu
# Lower priority number wins among free slots. Zero capacity disables a pool.
# Keep this coordinator policy identical on ingress and the local fallback.
WORKER_POLICIES={"wsl-cpu":{"priority":10,"max_concurrency":2},"mac-m3-pro":{"priority":20,"max_concurrency":2},"wsl-gpu":{"priority":30,"max_concurrency":1},"server-fallback":{"priority":100,"max_concurrency":1}}
WORKER_DEMAND_TTL_S=10
WORKER_AVAILABILITY_TTL_S=90
WORKER_FALLBACK=1
SERVER_WORKER_MODEL=large
SERVER_WORKER_COMPUTE_TYPE=int8
SERVER_WORKER_CPU_THREADS=8
SERVER_WORKER_CONCURRENCY=1
SERVER_WORKER_CPU_LIMIT=8
SERVER_WORKER_MEMORY_LIMIT=4g
