TRANSCRIBER_ROLE=server
WORKER_TLS_ENABLED=1
WORKER_CREDENTIALS_PATH=/home/your-login/.config/transcriber/worker-credentials.json
PREFERRED_WORKER_IDS=mac-m3-pro,wsl-gpu,wsl-cpu
WORKER_AVAILABILITY_TTL_S=90
WORKER_FALLBACK=1
SERVER_WORKER_MODEL=large
SERVER_WORKER_COMPUTE_TYPE=int8
SERVER_WORKER_CPU_THREADS=8
SERVER_WORKER_CPU_LIMIT=8
SERVER_WORKER_MEMORY_LIMIT=4g
