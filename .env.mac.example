TRANSCRIBER_ROLE=workers
COMPOSE_PROJECT_NAME=transcriber-workers
COMPOSE_PROFILES=cpu
CPU_WORKER_ID=mac-m3-pro
CPU_MODEL=large-v3
CPU_COMPUTE_TYPE=int8
CPU_THREADS=2
CPU_LIMIT=2
CPU_MEMORY_LIMIT=5500m
WORKER_UID=501
WORKER_GID=20
MODEL_CACHE_PATH=/Users/your-login/.cache/huggingface
WORKER_TOKEN_PATH=/Users/your-login/.config/transcriber/worker.token
SSH_HOST=your-coordinator-host
SSH_USER=your-ssh-login
SSH_PORT=22
SSH_IDENTITY_PATH=/Users/your-login/.ssh/id_ed25519_transcriber
SSH_KNOWN_HOSTS_PATH=/Users/your-login/.ssh/known_hosts_transcriber

# Enable after the first approved public GHCR release. make up resolves it.
WORKER_AUTODEPLOY=0
