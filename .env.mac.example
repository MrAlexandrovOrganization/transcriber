TRANSCRIBER_ROLE=workers
COMPOSE_PROJECT_NAME=transcriber-workers
COMPOSE_PROFILES=cpu
CPU_WORKER_ID=mac-m3-pro
CPU_MODEL=large-v3
CPU_COMPUTE_TYPE=int8
CPU_THREADS=2
CPU_CONCURRENCY=2
CPU_LIMIT=4
CPU_MEMORY_LIMIT=5500m
WORKER_UID=501
WORKER_GID=20
MODEL_CACHE_PATH=/Users/your-login/.cache/huggingface
CPU_WORKER_TOKEN_PATH=/Users/your-login/.config/transcriber/cpu.token
REMOTE_WORKER_ENDPOINT=workers.example.com:443

# Enable after the first approved public GHCR release. make up resolves it.
WORKER_AUTODEPLOY=0

# RabbitMQ cutover: provision credentials first; see docs/rabbitmq.md.
# QUEUE_BACKEND=rabbitmq
# CPU_RABBITMQ_DIR=/absolute/private/path/to/this-worker-rabbitmq
# Docker Desktop private routing (one identity per device):
# WORKER_TAILNET=1
# WORKER_TAILNET_HOSTNAME=transcriber-workers-mac
# HEADSCALE_LOGIN_SERVER=https://headscale.example.com
# HEADSCALE_AUTHKEY_PATH=/absolute/private/path/to/headscale.key
